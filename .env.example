# Claves de API
GROQ_API_KEY=tu_api_key_de_groq_aqui

# Base de datos MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tfg_pneumonia

# JWT (genera una clave segura con: openssl rand -hex 32)
JWT_SECRET_KEY=genera_una_clave_segura
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Demo en vivo (OPCIONAL) - rutas preconfiguradas para lanzar entrenamiento/validacion
# sin abrir el dialogo Tkinter (usado cuando el servidor esta desatendido). Si se dejan
# vacias, "Explorar Carpeta" abre el dialogo como siempre.
TFG_DEMO_DATASET=
TFG_DEMO_EXTERNAL_DATASET=

# Tunel para la demo: cloudflared (por defecto) o ngrok
TUNNEL_PROVIDER=cloudflared
