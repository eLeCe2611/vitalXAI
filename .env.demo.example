# Copia este archivo a .env.demo y sustituye los valores de ejemplo.
# No guardes la copia real en Git.

DB_NAME=tfg_pneumonia
DB_ROOT_PASSWORD=change-this-demo-password
DB_USER=vitalxai
DB_PASSWORD=change-this-app-password
DB_POOL_SIZE=5

# Déjala vacía si el chatbot no se utilizará durante la defensa.
GROQ_API_KEY=

# Debe ser una clave diferente de la utilizada en desarrollo.
JWT_SECRET_KEY=change-this-demo-jwt-secret
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Rutas internas del contenedor. No son rutas de Windows.
TFG_DEMO_DATASET=/app/demo-data
TUNNEL_PROVIDER=cloudflared

# La imagen se prepara para la mayoría de ordenadores Windows/Intel/AMD.
DOCKER_PLATFORM=linux/amd64
APP_BIND_ADDRESS=127.0.0.1
